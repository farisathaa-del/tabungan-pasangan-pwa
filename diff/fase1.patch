+    /* ── Helper perhitungan (Fase 1) ──────────────────────────────────
+       Semua total uang dihitung dari nominal tiap record, bukan jumlah
+       record. Sebelumnya memakai `records.length * config.nominal`, yang
+       salah begitu nominal tidak seragam atau ada record duplikat. */
+
+    function getNominal() {
+      const n = APP_DATABASE.config && Number(APP_DATABASE.config.nominal);
+      return Number.isFinite(n) && n > 0 ? n : 100000;
+    }
+
+    function sumNominal(records) {
+      if (!Array.isArray(records)) return 0;
+      return records.reduce((total, r) => {
+        const n = Number(r && r.nominal);
+        return total + (Number.isFinite(n) ? n : getNominal());
+      }, 0);
+    }
+
+    /** Perbandingan bulan yang tahan beda tipe ("10" vs 10) dari server. */
+    function isRecordInMonth(record, year, month) {
+      return Boolean(record) &&
+        Number(record.year) === Number(year) &&
+        Number(record.monthIndex) === Number(month);
+    }
+
+    function weekKey(record) {
+      return `${record.year}|${record.monthIndex}|${record.dayId}`;
+    }
+
+    /**
+     * Minggu yang sudah lunas: ada setoran dari Faris (A) DAN Saidah (B).
+     * Pengganti Math.floor(records.length / 2) yang ikut naik saat ada
+     * record duplikat dan tidak peduli salah satu belum menyusul.
+     */
+    function countFullyPaidWeeks(records) {
+      if (!Array.isArray(records)) return 0;
+      const slots = new Map();
+      records.forEach(r => {
+        if (!r) return;
+        const key = weekKey(r);
+        if (!slots.has(key)) slots.set(key, { A: false, B: false });
+        if (r.user === 'A') slots.get(key).A = true;
+        else if (r.user === 'B') slots.get(key).B = true;
+      });
+      let count = 0;
+      slots.forEach(slot => { if (slot.A && slot.B) count++; });
+      return count;
+    }
+
+    /** Jumlah minggu lunas di seluruh periode — dasar progres tanaman & balon. */
+    function getTotalPaidWeeks() {
+      return countFullyPaidWeeks(APP_DATABASE.records);
+    }
